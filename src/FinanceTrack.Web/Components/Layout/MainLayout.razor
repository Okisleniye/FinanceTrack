@inherits LayoutComponentBase

<div class="page d-flex flex-column flex-md-row min-vh-100">
    <!-- Desktop & Mobile Collapsible Sidebar -->
    <div class="sidebar text-white @(isMobileNavOpen ? "d-block" : "d-none d-md-block")" style="width: 260px; min-height: 100vh;">
        <NavMenu OnNavigate="CloseMobileNav" />
    </div>

    <!-- Mobile Backdrop overlay when menu is open -->
    @if (isMobileNavOpen)
    {
        <div class="d-md-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50" 
             style="z-index: 1020;" 
             @onclick="CloseMobileNav">
        </div>
    }

    <!-- Main Content Area -->
    <main class="flex-grow-1 bg-light d-flex flex-column min-vh-100">
        <!-- Top Navbar -->
        <header class="navbar navbar-expand navbar-light bg-white border-bottom px-3 px-md-4 py-2 d-flex justify-content-between align-items-center shadow-sm">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary d-md-none" @onclick="ToggleMobileNav" aria-label="Toggle navigation menu">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <span class="text-muted small d-none d-sm-inline">Personal Finance Management System</span>
                <span class="fw-bold d-sm-none text-primary">FinanceTrack</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-lg-inline">
                    <i class="bi bi-clock me-1"></i>@DateTime.Today.ToString("dddd, dd MMMM yyyy")
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="bi bi-cash me-1"></i>KZT (₸)
                </span>
            </div>
        </header>

        <!-- Main Body Content -->
        <article class="content px-3 px-md-4 py-4 flex-grow-1">
            @Body
        </article>

        <!-- Application Footer -->
        <footer class="bg-white border-top py-3 px-4 text-center text-muted small">
            <div class="container-fluid p-0 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div>
                    <strong>FinanceTrack</strong> &bull; University Software Project
                </div>
                <div>
                    <span>Currency: <strong>Kazakhstani Tenge (₸)</strong> &bull; .NET 10 Blazor Server</span>
                </div>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 d-none">
    An unhandled error has occurred.
    <a href="" class="reload btn btn-sm btn-outline-danger ms-2">Reload</a>
    <a class="dismiss btn-close ms-2" aria-label="Close"></a>
</div>

@code {
    private bool isMobileNavOpen = false;

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
    }

    private void CloseMobileNav()
    {
        isMobileNavOpen = false;
    }
}
