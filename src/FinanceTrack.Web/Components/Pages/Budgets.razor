@page "/budgets"
@rendermode InteractiveServer
@inject IBudgetService BudgetService
@inject ICategoryService CategoryService

<PageTitle>FinanceTrack — Budgets</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Monthly Budgets</h1>
            <p class="text-muted mb-0">Plan, track, and control your monthly spending by category.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg"></i>
                <span>Set Budget</span>
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Month & Year Selector Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center justify-content-between">
                <div class="col-12 col-md-auto d-flex align-items-center gap-2">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PreviousMonth" title="Previous Month">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select form-select-sm fw-semibold" style="width: 140px;" value="@selectedMonth" @onchange="OnMonthChanged">
                            @for (int m = 1; m <= 12; m++)
                            {
                                var monthNum = m;
                                <option value="@monthNum">@GetMonthName(monthNum)</option>
                            }
                        </select>

                        <select class="form-select form-select-sm fw-semibold" style="width: 100px;" value="@selectedYear" @onchange="OnYearChanged">
                            @for (int y = currentYear - 3; y <= currentYear + 3; y++)
                            {
                                var yearNum = y;
                                <option value="@yearNum">@yearNum</option>
                            }
                        </select>
                    </div>

                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth" title="Next Month">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <button class="btn btn-sm btn-link text-decoration-none" @onclick="SetCurrentMonth">
                        Today
                    </button>
                </div>

                <div class="col-12 col-md-auto text-muted small">
                    Budget Period: <strong>@GetMonthName(selectedMonth) @selectedYear</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Total Budgeted</div>
                    <div class="fs-4 fw-bold text-primary">@FormatMoney(TotalBudgeted)</div>
                    <div class="text-muted small mt-1">@budgets.Count active budget(s)</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Total Spent</div>
                    <div class="fs-4 fw-bold text-danger">@FormatMoney(TotalSpent)</div>
                    <div class="text-muted small mt-1">Actual expenses in period</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Remaining</div>
                    <div class="fs-4 fw-bold @(TotalRemaining < 0 ? "text-danger" : "text-success")">
                        @FormatMoney(TotalRemaining)
                    </div>
                    <div class="text-muted small mt-1">
                        @(TotalRemaining < 0 ? "Total budget exceeded" : "Under total budget")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase mb-1">Overall Usage</div>
                    <div class="fs-4 fw-bold @(OverallPercentageUsed > 100 ? "text-danger" : "text-dark")">
                        @OverallPercentageUsed%
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @GetProgressBarClass(OverallPercentageUsed)" 
                             role="progressbar" 
                             style="width: @Math.Min(OverallPercentageUsed, 100m)%;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Budgets List / Grid -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-5 text-center text-muted">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div>Loading budgets...</div>
                </div>
            }
            else if (!budgets.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-piggy-bank display-4 text-secondary mb-3 d-block"></i>
                    <h5 class="fw-semibold text-dark">No budgets set for @GetMonthName(selectedMonth) @selectedYear</h5>
                    <p class="mb-3 text-muted">Set spending targets for your expense categories to keep finances on track.</p>
                    <button class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
                        <i class="bi bi-plus-lg me-1"></i> Set Budget for @GetMonthName(selectedMonth)
                    </button>
                </div>
            }
            else
            {
                <div class="p-3">
                    <div class="row g-3">
                        @foreach (var b in budgets)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card h-100 border @(b.IsOverBudget ? "border-danger shadow-sm" : "border-light shadow-sm")">
                                    <div class="card-body p-3">
                                        <!-- Top Row: Icon, Name, Actions -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="d-flex align-items-center justify-content-center rounded-circle text-white shadow-sm"
                                                     style="width: 36px; height: 36px; background-color: @b.CategoryColor;">
                                                    <i class="bi @b.CategoryIcon"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold text-dark">@b.CategoryName</h6>
                                                    <span class="text-muted small">@GetMonthName(b.Month) @b.Year</span>
                                                </div>
                                            </div>

                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary" @onclick="() => OpenEditModal(b)" title="Edit budget">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => OpenDeleteModal(b)" title="Delete budget">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Metrics -->
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <span class="text-muted small">Spent:</span>
                                            <span class="fw-bold @(b.IsOverBudget ? "text-danger" : "text-dark")">
                                                @FormatMoney(b.AmountSpent)
                                            </span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                                            <span class="text-muted small">Budget:</span>
                                            <span class="fw-semibold text-muted">@FormatMoney(b.Amount)</span>
                                        </div>

                                        <!-- Progress Bar -->
                                        <div class="progress mb-2" style="height: 8px;">
                                            <div class="progress-bar @GetProgressBarClass(b.PercentageUsed)" 
                                                 role="progressbar" 
                                                 style="width: @Math.Min(b.PercentageUsed, 100m)%;">
                                            </div>
                                        </div>

                                        <!-- Status and Remaining -->
                                        <div class="d-flex justify-content-between align-items-center small">
                                            <span>
                                                @if (b.IsOverBudget)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Over Budget (@b.PercentageUsed%)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        @b.PercentageUsed% used
                                                    </span>
                                                }
                                            </span>

                                            <span class="@(b.RemainingAmount < 0 ? "text-danger fw-bold" : "text-muted")">
                                                @(b.RemainingAmount < 0 
                                                    ? $"Exceeded by {FormatMoney(Math.Abs(b.RemainingAmount))}" 
                                                    : $"{FormatMoney(b.RemainingAmount)} left")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- CREATE / EDIT MODAL                                                    -->
<!-- ====================================================================== -->
@if (showFormModal)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1" @onclick="CloseFormModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(isEditing ? "bi-pencil-square text-primary" : "bi-plus-circle text-primary") me-2"></i>
                        @(isEditing ? "Edit Budget" : "Set Monthly Budget")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseFormModal" aria-label="Close"></button>
                </div>

                <EditForm Model="formModel" OnValidSubmit="HandleFormSubmit">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(modalErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small mb-3">
                                <i class="bi bi-exclamation-circle me-1"></i> @modalErrorMessage
                            </div>
                        }

                        <!-- Category Selector (Strictly Expense Categories) -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Expense Category *</label>
                            @if (isEditing)
                            {
                                var catName = expenseCategories.FirstOrDefault(c => c.Id == formModel.CategoryId)?.Name ?? "Selected Category";
                                <input type="text" class="form-control bg-light" value="@catName" readonly />
                            }
                            else
                            {
                                <select class="form-select" @bind="formModel.CategoryId">
                                    <option value="0">-- Select Expense Category --</option>
                                    @foreach (var cat in AvailableExpenseCategories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                </select>
                            }
                            <ValidationMessage For="@(() => formModel.CategoryId)" class="text-danger small mt-1" />
                        </div>

                        <!-- Budget Amount -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Budget Amount (₸) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">₸</span>
                                <InputNumber @bind-Value="formModel.Amount" 
                                             class="form-control" 
                                             placeholder="0.00" 
                                             step="0.01" />
                            </div>
                            <ValidationMessage For="@(() => formModel.Amount)" class="text-danger small mt-1" />
                        </div>

                        <!-- Period: Month & Year -->
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label small fw-semibold text-muted">Month *</label>
                                <select class="form-select" @bind="formModel.Month" disabled="@isEditing">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        var mNum = m;
                                        <option value="@mNum">@GetMonthName(mNum)</option>
                                    }
                                </select>
                                <ValidationMessage For="@(() => formModel.Month)" class="text-danger small mt-1" />
                            </div>

                            <div class="col-5">
                                <label class="form-label small fw-semibold text-muted">Year *</label>
                                <select class="form-select" @bind="formModel.Year" disabled="@isEditing">
                                    @for (int y = currentYear - 3; y <= currentYear + 3; y++)
                                    {
                                        var yNum = y;
                                        <option value="@yNum">@yNum</option>
                                    }
                                </select>
                                <ValidationMessage For="@(() => formModel.Year)" class="text-danger small mt-1" />
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormModal" disabled="@isSubmitting">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>@(isEditing ? "Save Changes" : "Save Budget")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- ====================================================================== -->
<!-- DELETE CONFIRMATION MODAL                                              -->
<!-- ====================================================================== -->
@if (showDeleteModal && budgetToDelete != null)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1" @onclick="CloseFormModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Budget
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal" aria-label="Close"></button>
                </div>

                <div class="modal-body py-3">
                    <p class="mb-3">Are you sure you want to delete this budget for <strong>@budgetToDelete.CategoryName</strong> (@GetMonthName(budgetToDelete.Month) @budgetToDelete.Year)?</p>

                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Category:</span>
                            <span class="fw-semibold">@budgetToDelete.CategoryName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Period:</span>
                            <span>@GetMonthName(budgetToDelete.Month) @budgetToDelete.Year</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Budget Amount:</span>
                            <span class="fw-bold">@FormatMoney(budgetToDelete.Amount)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Actual Spent:</span>
                            <span class="fw-bold text-danger">@FormatMoney(budgetToDelete.AmountSpent)</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-1" @onclick="ConfirmDelete" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                            <span>Delete Budget</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BudgetDto> budgets = new();
    private List<CategoryDto> expenseCategories = new();

    private int selectedMonth = DateTime.Today.Month;
    private int selectedYear = DateTime.Today.Year;
    private readonly int currentYear = DateTime.Today.Year;

    // UI state
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private string? modalErrorMessage;

    // Modal state
    private bool showFormModal = false;
    private bool isEditing = false;
    private BudgetFormModel formModel = new();

    private bool showDeleteModal = false;
    private BudgetDto? budgetToDelete;

    private decimal TotalBudgeted => budgets.Sum(b => b.Amount);
    private decimal TotalSpent => budgets.Sum(b => b.AmountSpent);
    private decimal TotalRemaining => TotalBudgeted - TotalSpent;
    private decimal OverallPercentageUsed => TotalBudgeted > 0 ? Math.Round((TotalSpent / TotalBudgeted) * 100, 1) : 0;

    // For create modal: show expense categories that don't already have a budget this period, plus any currently selected
    private IEnumerable<CategoryDto> AvailableExpenseCategories
    {
        get
        {
            if (isEditing) return expenseCategories;
            var budgetedCategoryIds = budgets.Select(b => b.CategoryId).ToHashSet();
            return expenseCategories.Where(c => !budgetedCategoryIds.Contains(c.Id) || c.Id == formModel.CategoryId);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadExpenseCategoriesAsync();
        await LoadBudgetsAsync();
    }

    private async Task LoadExpenseCategoriesAsync()
    {
        try
        {
            var categories = await CategoryService.GetAllAsync(TransactionType.Expense);
            expenseCategories = categories.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load categories: {ex.Message}";
        }
    }

    private async Task LoadBudgetsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await BudgetService.GetAllAsync(selectedYear, selectedMonth);
            budgets = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load budgets: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            selectedMonth = m;
            await LoadBudgetsAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            selectedYear = y;
            await LoadBudgetsAsync();
        }
    }

    private async Task PreviousMonth()
    {
        if (selectedMonth == 1)
        {
            selectedMonth = 12;
            selectedYear--;
        }
        else
        {
            selectedMonth--;
        }
        await LoadBudgetsAsync();
    }

    private async Task NextMonth()
    {
        if (selectedMonth == 12)
        {
            selectedMonth = 1;
            selectedYear++;
        }
        else
        {
            selectedMonth++;
        }
        await LoadBudgetsAsync();
    }

    private async Task SetCurrentMonth()
    {
        selectedMonth = DateTime.Today.Month;
        selectedYear = DateTime.Today.Year;
        await LoadBudgetsAsync();
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        modalErrorMessage = null;
        formModel = new BudgetFormModel
        {
            Amount = 0m,
            Month = selectedMonth,
            Year = selectedYear,
            CategoryId = AvailableExpenseCategories.FirstOrDefault()?.Id ?? 0
        };
        showFormModal = true;
    }

    private void OpenEditModal(BudgetDto budget)
    {
        isEditing = true;
        modalErrorMessage = null;
        formModel = BudgetFormModel.FromDto(budget);
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        modalErrorMessage = null;
    }

    private async Task HandleFormSubmit()
    {
        isSubmitting = true;
        modalErrorMessage = null;

        try
        {
            if (isEditing)
            {
                var updateDto = formModel.ToUpdateDto();
                await BudgetService.UpdateAsync(updateDto);
                successMessage = "Budget updated successfully.";
            }
            else
            {
                var createDto = formModel.ToCreateDto();
                await BudgetService.CreateAsync(createDto);
                successMessage = "Budget created successfully.";
            }

            CloseFormModal();
            await LoadBudgetsAsync();
        }
        catch (ApplicationValidationException vex)
        {
            modalErrorMessage = vex.Message;
        }
        catch (NotFoundException nfe)
        {
            modalErrorMessage = nfe.Message;
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDeleteModal(BudgetDto budget)
    {
        budgetToDelete = budget;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        budgetToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (budgetToDelete == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var success = await BudgetService.DeleteAsync(budgetToDelete.Id);
            if (success)
            {
                successMessage = $"Budget for '{budgetToDelete.CategoryName}' deleted successfully.";
            }
            else
            {
                errorMessage = "Failed to delete budget. It may have already been removed.";
            }

            CloseDeleteModal();
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting budget: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string GetMonthName(int month) =>
        new DateTime(2026, Math.Clamp(month, 1, 12), 1).ToString("MMMM", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatMoney(decimal amount) =>
        $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} ₸";

    private static string GetProgressBarClass(decimal percentage) =>
        percentage switch
        {
            > 100 => "bg-danger",
            >= 75 => "bg-warning",
            _ => "bg-success"
        };
}
