@page "/"
@rendermode InteractiveServer
@inject IDashboardService DashboardService
@inject IReportService ReportService
@inject IJSRuntime JS

<PageTitle>FinanceTrack — Financial Dashboard</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Financial Dashboard</h1>
            <p class="text-muted mb-0">Overview of your current month finances, spending habits, and trends.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="transactions" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-arrow-left-right"></i>
                <span>All Transactions</span>
            </a>
            <a href="transactions" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-plus-lg"></i>
                <span>Add Transaction</span>
            </a>
        </div>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="p-5 text-center text-muted card border-0 shadow-sm">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div>Loading financial overview...</div>
        </div>
    }
    else if (summary != null)
    {
        <!-- Key Metrics Cards -->
        <div class="row g-3 mb-4">
            <!-- Current Month Income -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Month Income</div>
                                <div class="fs-4 fw-bold text-success mt-1">+@FormatMoney(summary.CurrentMonthIncome)</div>
                                <div class="text-muted small mt-1">@DateTime.Today.ToString("MMMM yyyy")</div>
                            </div>
                            <div class="bg-success-subtle text-success p-3 rounded-circle">
                                <i class="bi bi-arrow-down-left fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Current Month Expenses -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-danger border-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Month Expenses</div>
                                <div class="fs-4 fw-bold text-danger mt-1">-@FormatMoney(summary.CurrentMonthExpenses)</div>
                                <div class="text-muted small mt-1">@DateTime.Today.ToString("MMMM yyyy")</div>
                            </div>
                            <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                                <i class="bi bi-arrow-up-right fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Current Month Net Balance -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start @(summary.CurrentMonthBalance >= 0 ? "border-primary" : "border-warning") border-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Month Balance</div>
                                <div class="fs-4 fw-bold @(summary.CurrentMonthBalance >= 0 ? "text-primary" : "text-danger") mt-1">
                                    @(summary.CurrentMonthBalance >= 0 ? "+" : "")@FormatMoney(summary.CurrentMonthBalance)
                                </div>
                                <div class="text-muted small mt-1">Net savings this month</div>
                            </div>
                            <div class="@(summary.CurrentMonthBalance >= 0 ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning") p-3 rounded-circle">
                                <i class="bi @(summary.CurrentMonthBalance >= 0 ? "bi-wallet2" : "bi-exclamation-circle") fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Overall Total Balance -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small fw-semibold text-uppercase">Total Balance</div>
                                <div class="fs-4 fw-bold @(summary.TotalBalance >= 0 ? "text-dark" : "text-danger") mt-1">
                                    @FormatMoney(summary.TotalBalance)
                                </div>
                                <div class="text-muted small mt-1">All-time net financial position</div>
                            </div>
                            <div class="bg-info-subtle text-info p-3 rounded-circle">
                                <i class="bi bi-bank fs-4"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Income vs Expense Bar Comparison & Trends -->
        <div class="row g-4 mb-4">
            <!-- 6-Month Trends Chart -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">Financial Trends (Last 6 Months)</h5>
                        <a href="reports" class="btn btn-sm btn-link text-decoration-none">Full Report &rarr;</a>
                    </div>
                    <div class="card-body p-3">
                        @if (monthlyTrends.Any(t => t.Income > 0 || t.Expenses > 0))
                        {
                            <div style="height: 280px; position: relative;">
                                <canvas id="dashboardTrendsChart"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-bar-chart display-4 text-secondary mb-3 d-block"></i>
                                <p class="mb-0">No transaction trends available yet. Record income and expenses to see your trend chart.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Month Category Spending Doughnut Chart -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="card-title mb-0 fw-bold">Spending by Category</h5>
                    </div>
                    <div class="card-body p-3">
                        @if (summary.SpendingByCategory.Any())
                        {
                            <div style="height: 200px; position: relative;" class="mb-3">
                                <canvas id="dashboardCategoryChart"></canvas>
                            </div>

                            <div class="category-breakdown-list" style="max-height: 180px; overflow-y: auto;">
                                @foreach (var cat in summary.SpendingByCategory)
                                {
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: @cat.Color;"></span>
                                            <span class="small fw-semibold text-dark">@cat.CategoryName</span>
                                        </div>
                                        <div class="text-end small">
                                            <span class="fw-bold">@FormatMoney(cat.TotalAmount)</span>
                                            <span class="text-muted ms-1">(@cat.Percentage%)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-pie-chart display-5 text-secondary mb-2 d-block"></i>
                                <p class="small mb-0">No expenses recorded for this month.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions & Budget Overview -->
        <div class="row g-4 mb-4">
            <!-- Recent Transactions Table -->
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">Recent Transactions</h5>
                        <a href="transactions" class="btn btn-sm btn-link text-decoration-none">View All &rarr;</a>
                    </div>
                    <div class="card-body p-0">
                        @if (!summary.RecentTransactions.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-receipt display-5 text-secondary mb-2 d-block"></i>
                                <p class="mb-2">No transactions recorded yet.</p>
                                <a href="transactions" class="btn btn-sm btn-primary">Add Your First Transaction</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3 py-2 small text-muted">Date</th>
                                            <th class="py-2 small text-muted">Description</th>
                                            <th class="py-2 small text-muted">Category</th>
                                            <th class="pe-3 py-2 text-end small text-muted">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in summary.RecentTransactions)
                                        {
                                            <tr>
                                                <td class="ps-3 text-muted small">@t.Date.ToString("dd.MM.yyyy")</td>
                                                <td class="fw-semibold text-dark">@t.Description</td>
                                                <td>
                                                    <span class="badge rounded-pill text-white px-2 py-1" style="background-color: @t.CategoryColor;">
                                                        <i class="bi @t.CategoryIcon me-1"></i>@t.CategoryName
                                                    </span>
                                                </td>
                                                <td class="pe-3 text-end fw-bold @(t.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                                    @(t.Type == TransactionType.Income ? "+" : "-")@FormatMoney(t.Amount)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Current Month Budget Status -->
            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-bold">Monthly Budgets Overview</h5>
                        <a href="budgets" class="btn btn-sm btn-link text-decoration-none">Manage Budgets &rarr;</a>
                    </div>
                    <div class="card-body p-3">
                        @if (!summary.BudgetOverview.Any())
                        {
                            <div class="p-4 text-center text-muted">
                                <i class="bi bi-piggy-bank display-5 text-secondary mb-2 d-block"></i>
                                <p class="mb-2">No budgets set for this month.</p>
                                <a href="budgets" class="btn btn-sm btn-primary">Set Monthly Budget</a>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var b in summary.BudgetOverview.Take(4))
                                {
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-semibold small text-dark">
                                                <i class="bi @b.CategoryIcon me-1" style="color: @b.CategoryColor;"></i>
                                                @b.CategoryName
                                            </span>
                                            <span class="small @(b.IsOverBudget ? "text-danger fw-bold" : "text-muted")">
                                                @FormatMoney(b.AmountSpent) / @FormatMoney(b.Amount)
                                            </span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @(b.IsOverBudget ? "bg-danger" : b.PercentageUsed >= 75 ? "bg-warning" : "bg-success")"
                                                 role="progressbar" 
                                                 style="width: @Math.Min(b.PercentageUsed, 100m)%;">
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardSummaryDto? summary;
    private List<MonthlyTrendDto> monthlyTrends = new();
    private bool isLoading = true;
    private string? errorMessage;
    private bool chartsRendered = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            summary = await DashboardService.GetSummaryAsync();
            var trends = await ReportService.GetMonthlyTrendsAsync(6);
            monthlyTrends = trends.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && summary != null && !chartsRendered)
        {
            chartsRendered = true;
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            // 1. Render Category Doughnut Chart
            if (summary != null && summary.SpendingByCategory.Any())
            {
                var labels = summary.SpendingByCategory.Select(c => c.CategoryName).ToArray();
                var data = summary.SpendingByCategory.Select(c => (double)c.TotalAmount).ToArray();
                var colors = summary.SpendingByCategory.Select(c => c.Color).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderDoughnut", "dashboardCategoryChart", labels, data, colors);
            }

            // 2. Render Trends Bar Chart
            if (monthlyTrends.Any(t => t.Income > 0 || t.Expenses > 0))
            {
                var trendLabels = monthlyTrends.Select(t => t.MonthName).ToArray();
                var incomeData = monthlyTrends.Select(t => (double)t.Income).ToArray();
                var expenseData = monthlyTrends.Select(t => (double)t.Expenses).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderBarComparison", "dashboardTrendsChart", trendLabels, incomeData, expenseData);
            }
        }
        catch
        {
            // Fallback gracefully if JS interop fails in non-browser context
        }
    }

    private static string FormatMoney(decimal amount) =>
        $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} ₸";
}
