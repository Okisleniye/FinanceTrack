@page "/reports"
@rendermode InteractiveServer
@inject IReportService ReportService
@inject IJSRuntime JS

<PageTitle>FinanceTrack — Reports & Analytics</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Reports & Analytics</h1>
            <p class="text-muted mb-0">Detailed analysis of income, expenses, category breakdowns, and financial trends.</p>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                <i class="bi bi-calendar3 me-1"></i>
                @startDate.ToString("dd.MM.yyyy") — @endDate.ToString("dd.MM.yyyy")
            </span>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Period Selection Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center justify-content-between">
                <!-- Preset Filters -->
                <div class="col-12 col-lg-auto d-flex flex-wrap gap-1">
                    <button class="btn btn-sm @(selectedPreset == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPreset("ThisMonth")'>
                        This Month
                    </button>
                    <button class="btn btn-sm @(selectedPreset == "LastMonth" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPreset("LastMonth")'>
                        Last Month
                    </button>
                    <button class="btn btn-sm @(selectedPreset == "Last6Months" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPreset("Last6Months")'>
                        Last 6 Months
                    </button>
                    <button class="btn btn-sm @(selectedPreset == "ThisYear" ? "btn-primary" : "btn-outline-secondary")" @onclick='() => SetPreset("ThisYear")'>
                        This Year
                    </button>
                </div>

                <!-- Custom Range Inputs -->
                <div class="col-12 col-lg-auto d-flex flex-wrap align-items-center gap-2">
                    <div class="d-flex align-items-center gap-1">
                        <label class="small text-muted mb-0">From:</label>
                        <input type="date" class="form-control form-control-sm" style="width: 140px;" @bind="startDate" />
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="small text-muted mb-0">To:</label>
                        <input type="date" class="form-control form-control-sm" style="width: 140px;" @bind="endDate" />
                    </div>
                    <button class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" @onclick="ApplyCustomRange">
                        <i class="bi bi-filter"></i> Apply
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-5 text-center text-muted card border-0 shadow-sm">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div>Generating financial report...</div>
        </div>
    }
    else if (report != null)
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-success border-4">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-uppercase">Total Income</div>
                        <div class="fs-4 fw-bold text-success mt-1">+@FormatMoney(report.TotalIncome)</div>
                        <div class="text-muted small mt-1">Inflow for period</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-danger border-4">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-uppercase">Total Expenses</div>
                        <div class="fs-4 fw-bold text-danger mt-1">-@FormatMoney(report.TotalExpenses)</div>
                        <div class="text-muted small mt-1">Outflow for period</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start @(report.NetSavings >= 0 ? "border-primary" : "border-warning") border-4">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-uppercase">Net Savings</div>
                        <div class="fs-4 fw-bold @(report.NetSavings >= 0 ? "text-primary" : "text-danger") mt-1">
                            @(report.NetSavings >= 0 ? "+" : "")@FormatMoney(report.NetSavings)
                        </div>
                        <div class="text-muted small mt-1">Income minus expenses</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-info border-4">
                    <div class="card-body p-3">
                        <div class="text-muted small fw-semibold text-uppercase">Savings Rate</div>
                        <div class="fs-4 fw-bold text-info mt-1">@report.SavingsRate%</div>
                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-info" 
                                 role="progressbar" 
                                 style="width: @Math.Clamp(report.SavingsRate, 0m, 100m)%;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (report.TotalIncome == 0 && report.TotalExpenses == 0)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-5 text-center text-muted">
                    <i class="bi bi-calendar-x display-4 text-secondary mb-3 d-block"></i>
                    <h5 class="fw-semibold text-dark">No transactions found in this date range</h5>
                    <p class="mb-3 text-muted">Try selecting a different date range or add transactions for this period.</p>
                    <a href="transactions" class="btn btn-primary btn-sm">Go to Transactions</a>
                </div>
            </div>
        }
        else
        {
            <!-- Monthly Trend Bar Chart -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h5 class="card-title mb-0 fw-bold">Income vs Expenses Over Time</h5>
                </div>
                <div class="card-body p-3">
                    <div style="height: 300px; position: relative;">
                        <canvas id="reportTrendsChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Category Breakdowns (Expenses & Income) -->
            <div class="row g-4 mb-4">
                <!-- Expenses by Category -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white py-3 border-0">
                            <h5 class="card-title mb-0 fw-bold">Expense Breakdown by Category</h5>
                        </div>
                        <div class="card-body p-3">
                            @if (report.ExpensesByCategory.Any())
                            {
                                <div style="height: 220px; position: relative;" class="mb-3">
                                    <canvas id="reportExpenseChart"></canvas>
                                </div>

                                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-2">Category</th>
                                                <th class="text-end">Amount</th>
                                                <th class="text-end pe-2">Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in report.ExpensesByCategory)
                                            {
                                                <tr>
                                                    <td class="ps-2">
                                                        <span class="rounded-circle d-inline-block me-1" style="width: 10px; height: 10px; background-color: @cat.Color;"></span>
                                                        <i class="bi @cat.Icon me-1" style="color: @cat.Color;"></i>
                                                        <span class="fw-semibold text-dark">@cat.CategoryName</span>
                                                    </td>
                                                    <td class="text-end fw-bold text-danger">-@FormatMoney(cat.TotalAmount)</td>
                                                    <td class="text-end pe-2 text-muted">@cat.Percentage%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted">
                                    <p class="mb-0">No expenses recorded for this period.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Income by Category -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white py-3 border-0">
                            <h5 class="card-title mb-0 fw-bold">Income Breakdown by Category</h5>
                        </div>
                        <div class="card-body p-3">
                            @if (report.IncomeByCategory.Any())
                            {
                                <div style="height: 220px; position: relative;" class="mb-3">
                                    <canvas id="reportIncomeChart"></canvas>
                                </div>

                                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-2">Category</th>
                                                <th class="text-end">Amount</th>
                                                <th class="text-end pe-2">Share</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var cat in report.IncomeByCategory)
                                            {
                                                <tr>
                                                    <td class="ps-2">
                                                        <span class="rounded-circle d-inline-block me-1" style="width: 10px; height: 10px; background-color: @cat.Color;"></span>
                                                        <i class="bi @cat.Icon me-1" style="color: @cat.Color;"></i>
                                                        <span class="fw-semibold text-dark">@cat.CategoryName</span>
                                                    </td>
                                                    <td class="text-end fw-bold text-success">+@FormatMoney(cat.TotalAmount)</td>
                                                    <td class="text-end pe-2 text-muted">@cat.Percentage%</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted">
                                    <p class="mb-0">No income recorded for this period.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Monthly Trends Summary Table -->
            @if (report.MonthlyTrends.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="card-title mb-0 fw-bold">Monthly Period Breakdown</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3 py-2">Period</th>
                                        <th class="py-2 text-end">Income</th>
                                        <th class="py-2 text-end">Expenses</th>
                                        <th class="pe-3 py-2 text-end">Net Savings</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in report.MonthlyTrends)
                                    {
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark">@m.MonthName</td>
                                            <td class="text-end text-success fw-bold">+@FormatMoney(m.Income)</td>
                                            <td class="text-end text-danger fw-bold">-@FormatMoney(m.Expenses)</td>
                                            <td class="pe-3 text-end fw-bold @(m.NetSavings >= 0 ? "text-primary" : "text-danger")">
                                                @(m.NetSavings >= 0 ? "+" : "")@FormatMoney(m.NetSavings)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private FinancialReportDto? report;
    private DateTime startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime endDate = DateTime.Today;
    private string selectedPreset = "ThisMonth";
    private bool isLoading = true;
    private string? errorMessage;
    private bool chartsRendered = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task SetPreset(string preset)
    {
        selectedPreset = preset;
        var today = DateTime.Today;

        switch (preset)
        {
            case "ThisMonth":
                startDate = new DateTime(today.Year, today.Month, 1);
                endDate = today;
                break;
            case "LastMonth":
                var firstOfThisMonth = new DateTime(today.Year, today.Month, 1);
                var lastMonthEnd = firstOfThisMonth.AddDays(-1);
                startDate = new DateTime(lastMonthEnd.Year, lastMonthEnd.Month, 1);
                endDate = lastMonthEnd;
                break;
            case "Last6Months":
                startDate = new DateTime(today.Year, today.Month, 1).AddMonths(-5);
                endDate = today;
                break;
            case "ThisYear":
                startDate = new DateTime(today.Year, 1, 1);
                endDate = today;
                break;
        }

        await LoadReportAsync();
    }

    private async Task ApplyCustomRange()
    {
        selectedPreset = "Custom";
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        isLoading = true;
        errorMessage = null;
        chartsRendered = false;

        try
        {
            // Ensure end date includes the entire day
            var endOfDay = endDate.Date.AddDays(1).AddTicks(-1);
            report = await ReportService.GetReportAsync(startDate.Date, endOfDay);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to generate report: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && report != null && !chartsRendered)
        {
            chartsRendered = true;
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            // 1. Render Trends Chart
            if (report != null && report.MonthlyTrends.Any())
            {
                var labels = report.MonthlyTrends.Select(t => t.MonthName).ToArray();
                var incData = report.MonthlyTrends.Select(t => (double)t.Income).ToArray();
                var expData = report.MonthlyTrends.Select(t => (double)t.Expenses).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderBarComparison", "reportTrendsChart", labels, incData, expData);
            }

            // 2. Render Expenses Doughnut Chart
            if (report != null && report.ExpensesByCategory.Any())
            {
                var labels = report.ExpensesByCategory.Select(c => c.CategoryName).ToArray();
                var data = report.ExpensesByCategory.Select(c => (double)c.TotalAmount).ToArray();
                var colors = report.ExpensesByCategory.Select(c => c.Color).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderDoughnut", "reportExpenseChart", labels, data, colors);
            }

            // 3. Render Income Doughnut Chart
            if (report != null && report.IncomeByCategory.Any())
            {
                var labels = report.IncomeByCategory.Select(c => c.CategoryName).ToArray();
                var data = report.IncomeByCategory.Select(c => (double)c.TotalAmount).ToArray();
                var colors = report.IncomeByCategory.Select(c => c.Color).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderDoughnut", "reportIncomeChart", labels, data, colors);
            }
        }
        catch
        {
            // Fallback gracefully if JS interop is not ready or in SSR mode
        }
    }

    private static string FormatMoney(decimal amount) =>
        $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} ₸";
}
