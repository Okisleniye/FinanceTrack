@page "/transactions"
@rendermode InteractiveServer
@inject ITransactionService TransactionService
@inject ICategoryService CategoryService

<PageTitle>FinanceTrack — Transactions</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Transactions</h1>
            <p class="text-muted mb-0">Record, track, and manage your income and expenses.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm" @onclick="OpenCreateModal">
                <i class="bi bi-plus-lg"></i>
                <span>Add Transaction</span>
            </button>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@successMessage</div>
            <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Filter and Search Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- Search Box -->
                <div class="col-12 col-md-4 col-lg-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" 
                               class="form-control bg-light border-start-0" 
                               placeholder="Search description..." 
                               value="@searchTerm"
                               @oninput="OnSearchInput" />
                    </div>
                </div>

                <!-- Type Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select" value="@selectedTypeFilter" @onchange="OnTypeFilterChanged">
                        <option value="">All Types</option>
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </select>
                </div>

                <!-- Category Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select" value="@selectedCategoryId" @onchange="OnCategoryFilterChanged">
                        <option value="0">All Categories</option>
                        @foreach (var cat in FilterCategories)
                        {
                            <option value="@cat.Id">@cat.Name (@cat.TypeName)</option>
                        }
                    </select>
                </div>

                <!-- Sort Filter -->
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select" value="@sortBy" @onchange="OnSortChanged">
                        <option value="date_desc">Newest First</option>
                        <option value="date_asc">Oldest First</option>
                        <option value="amount_desc">Amount: High to Low</option>
                        <option value="amount_asc">Amount: Low to High</option>
                    </select>
                </div>

                <!-- Reset Filters Button -->
                <div class="col-6 col-md-3 col-lg-2">
                    <button class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center gap-1"
                            @onclick="ResetFilters"
                            title="Reset all filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>

            <!-- Date Range Collapsible/Sub-row -->
            <div class="row g-2 align-items-center mt-2 pt-2 border-top">
                <div class="col-auto text-muted small fw-semibold">
                    <i class="bi bi-calendar-range me-1"></i> Date Range:
                </div>
                <div class="col-12 col-sm-auto d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">From:</label>
                    <input type="date" class="form-control form-control-sm" value="@startDate?.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged" />
                </div>
                <div class="col-12 col-sm-auto d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0">To:</label>
                    <input type="date" class="form-control form-control-sm" value="@endDate?.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged" />
                </div>
                @if (startDate.HasValue || endDate.HasValue)
                {
                    <div class="col-auto">
                        <button class="btn btn-sm btn-link text-decoration-none p-0 text-muted" @onclick="ClearDateFilter">
                            Clear dates
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Transactions Data Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="p-5 text-center text-muted">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div>Loading transactions...</div>
                </div>
            }
            else if (pagedResult == null || pagedResult.Items.Count == 0)
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-receipt-cutoff display-4 text-secondary mb-3 d-block"></i>
                    <h5 class="fw-semibold text-dark">No transactions found</h5>
                    <p class="mb-3 text-muted">
                        @(HasActiveFilters ? "No transactions match your current filters. Try resetting the filters." : "You haven't recorded any transactions yet.")
                    </p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-outline-secondary btn-sm me-2" @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                        </button>
                    }
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenCreateModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Transaction
                    </button>
                </div>
            }
            else
            {
                <!-- Table View -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 py-3" style="width: 120px;">Date</th>
                                <th class="py-3">Description</th>
                                <th class="py-3" style="width: 170px;">Category</th>
                                <th class="py-3" style="width: 110px;">Type</th>
                                <th class="py-3 text-end" style="width: 160px;">Amount</th>
                                <th class="pe-3 py-3 text-center" style="width: 120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in pagedResult.Items)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">
                                        @t.Date.ToString("dd.MM.yyyy")
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark text-break">@t.Description</div>
                                        <div class="text-muted small d-md-none mt-1">
                                            <span class="badge" style="background-color: @t.CategoryColor">
                                                <i class="bi @t.CategoryIcon me-1"></i>@t.CategoryName
                                            </span>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <span class="badge rounded-pill text-white px-2 py-1" style="background-color: @t.CategoryColor;">
                                            <i class="bi @t.CategoryIcon me-1"></i>@t.CategoryName
                                        </span>
                                    </td>
                                    <td>
                                        @if (t.Type == TransactionType.Income)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-arrow-down-left me-1"></i>Income
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-arrow-up-right me-1"></i>Expense
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (t.Type == TransactionType.Income)
                                        {
                                            <span class="fw-bold text-success">
                                                +@FormatMoney(t.Amount)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-danger">
                                                -@FormatMoney(t.Amount)
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-3 text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" 
                                                    @onclick="() => OpenEditModal(t)" 
                                                    title="Edit transaction">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" 
                                                    @onclick="() => OpenDeleteModal(t)" 
                                                    title="Delete transaction">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <div class="card-footer bg-white border-0 py-3 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <div class="text-muted small">
                        Showing @(((pagedResult.PageNumber - 1) * pagedResult.PageSize) + 1) to 
                        @Math.Min(pagedResult.PageNumber * pagedResult.PageSize, pagedResult.TotalCount) 
                        of @pagedResult.TotalCount transactions
                    </div>

                    @if (pagedResult.TotalPages > 1)
                    {
                        <nav aria-label="Transaction pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(!pagedResult.HasPreviousPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber - 1)" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </button>
                                </li>

                                @for (int i = 1; i <= pagedResult.TotalPages; i++)
                                {
                                    var pageIdx = i;
                                    <li class="page-item @(pageIdx == pagedResult.PageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(pageIdx)">@pageIdx</button>
                                    </li>
                                }

                                <li class="page-item @(!pagedResult.HasNextPage ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pagedResult.PageNumber + 1)" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- ====================================================================== -->
<!-- CREATE / EDIT MODAL                                                    -->
<!-- ====================================================================== -->
@if (showFormModal)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1" @onclick="CloseFormModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(isEditing ? "bi-pencil-square text-primary" : "bi-plus-circle text-primary") me-2"></i>
                        @(isEditing ? "Edit Transaction" : "New Transaction")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseFormModal" aria-label="Close"></button>
                </div>

                <EditForm Model="formModel" OnValidSubmit="HandleFormSubmit">
                    <DataAnnotationsValidator />

                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(modalErrorMessage))
                        {
                            <div class="alert alert-danger py-2 px-3 small mb-3">
                                <i class="bi bi-exclamation-circle me-1"></i> @modalErrorMessage
                            </div>
                        }

                        <!-- Transaction Type -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Transaction Type</label>
                            <div class="btn-group w-100" role="group">
                                <input type="radio" 
                                       class="btn-check" 
                                       name="txnType" 
                                       id="btnTypeExpense" 
                                       checked="@(formModel.Type == TransactionType.Expense)"
                                       @onchange="() => OnFormTypeChanged(TransactionType.Expense)" />
                                <label class="btn btn-outline-danger" for="btnTypeExpense">
                                    <i class="bi bi-arrow-up-right me-1"></i> Expense
                                </label>

                                <input type="radio" 
                                       class="btn-check" 
                                       name="txnType" 
                                       id="btnTypeIncome" 
                                       checked="@(formModel.Type == TransactionType.Income)"
                                       @onchange="() => OnFormTypeChanged(TransactionType.Income)" />
                                <label class="btn btn-outline-success" for="btnTypeIncome">
                                    <i class="bi bi-arrow-down-left me-1"></i> Income
                                </label>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Category *</label>
                            <select class="form-select @(GetValidationClass(nameof(formModel.CategoryId)))"
                                    @bind="formModel.CategoryId">
                                <option value="0">-- Select Category --</option>
                                @foreach (var cat in FormCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                            <ValidationMessage For="@(() => formModel.CategoryId)" class="text-danger small mt-1" />
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Amount (₸) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">₸</span>
                                <InputNumber @bind-Value="formModel.Amount" 
                                             class="form-control" 
                                             placeholder="0.00" 
                                             step="0.01" />
                            </div>
                            <ValidationMessage For="@(() => formModel.Amount)" class="text-danger small mt-1" />
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Date *</label>
                            <InputDate @bind-Value="formModel.Date" class="form-control" />
                            <ValidationMessage For="@(() => formModel.Date)" class="text-danger small mt-1" />
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Description *</label>
                            <InputText @bind-Value="formModel.Description" 
                                       class="form-control" 
                                       placeholder="e.g. Weekly grocery shopping, Salary payment" 
                                       maxlength="200" />
                            <ValidationMessage For="@(() => formModel.Description)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseFormModal" disabled="@isSubmitting">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-1" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i>
                                <span>@(isEditing ? "Save Changes" : "Create Transaction")</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- ====================================================================== -->
<!-- DELETE CONFIRMATION MODAL                                              -->
<!-- ====================================================================== -->
@if (showDeleteModal && transactionToDelete != null)
{
    <div class="modal fade show d-block modal-backdrop-custom" tabindex="-1" @onclick="CloseFormModal">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Transaction
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal" aria-label="Close"></button>
                </div>

                <div class="modal-body py-3">
                    <p class="mb-3">Are you sure you want to delete this transaction? This action cannot be undone.</p>
                    
                    <div class="p-3 bg-light rounded border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Description:</span>
                            <span class="fw-semibold">@transactionToDelete.Description</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Category:</span>
                            <span>@transactionToDelete.CategoryName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Date:</span>
                            <span>@transactionToDelete.Date.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Amount:</span>
                            <span class="fw-bold @(transactionToDelete.Type == TransactionType.Income ? "text-success" : "text-danger")">
                                @(transactionToDelete.Type == TransactionType.Income ? "+" : "-")@FormatMoney(transactionToDelete.Amount)
                            </span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDeleteModal" disabled="@isSubmitting">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-1" @onclick="ConfirmDelete" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash"></i>
                            <span>Delete Transaction</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult<TransactionDto>? pagedResult;
    private List<CategoryDto> allCategories = new();
    
    // Filter & Search state
    private string searchTerm = string.Empty;
    private string selectedTypeFilter = string.Empty;
    private int selectedCategoryId = 0;
    private DateTime? startDate;
    private DateTime? endDate;
    private string sortBy = "date_desc";
    private int currentPage = 1;
    private const int PageSize = 15;

    // UI state
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? successMessage;
    private string? errorMessage;
    private string? modalErrorMessage;

    // Modal state
    private bool showFormModal = false;
    private bool isEditing = false;
    private TransactionFormModel formModel = new();

    private bool showDeleteModal = false;
    private TransactionDto? transactionToDelete;

    private IEnumerable<CategoryDto> FilterCategories =>
        string.IsNullOrEmpty(selectedTypeFilter)
            ? allCategories
            : allCategories.Where(c => c.Type.ToString() == selectedTypeFilter);

    private IEnumerable<CategoryDto> FormCategories =>
        allCategories.Where(c => c.Type == formModel.Type);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrEmpty(selectedTypeFilter) ||
        selectedCategoryId > 0 ||
        startDate.HasValue ||
        endDate.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
        await LoadTransactionsAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var categories = await CategoryService.GetAllAsync();
            allCategories = categories.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load categories: {ex.Message}";
        }
    }

    private async Task LoadTransactionsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            TransactionType? typeFilter = null;
            if (!string.IsNullOrEmpty(selectedTypeFilter) && 
                Enum.TryParse<TransactionType>(selectedTypeFilter, out var parsedType))
            {
                typeFilter = parsedType;
            }

            var filter = new TransactionFilterDto
            {
                SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim(),
                Type = typeFilter,
                CategoryId = selectedCategoryId > 0 ? selectedCategoryId : null,
                StartDate = startDate,
                EndDate = endDate,
                SortBy = sortBy,
                PageNumber = currentPage,
                PageSize = PageSize
            };

            pagedResult = await TransactionService.GetPagedAsync(filter);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load transactions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Filter event handlers
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnTypeFilterChanged(ChangeEventArgs e)
    {
        selectedTypeFilter = e.Value?.ToString() ?? string.Empty;
        
        // If the selected category is no longer in the filtered list, reset it
        if (selectedCategoryId > 0)
        {
            var valid = FilterCategories.Any(c => c.Id == selectedCategoryId);
            if (!valid)
            {
                selectedCategoryId = 0;
            }
        }

        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnCategoryFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var catId))
        {
            selectedCategoryId = catId;
        }
        else
        {
            selectedCategoryId = 0;
        }

        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        sortBy = e.Value?.ToString() ?? "date_desc";
        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            startDate = date;
        }
        else
        {
            startDate = null;
        }

        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task OnEndDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            endDate = date;
        }
        else
        {
            endDate = null;
        }

        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task ClearDateFilter()
    {
        startDate = null;
        endDate = null;
        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        selectedTypeFilter = string.Empty;
        selectedCategoryId = 0;
        startDate = null;
        endDate = null;
        sortBy = "date_desc";
        currentPage = 1;
        await LoadTransactionsAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || (pagedResult != null && page > pagedResult.TotalPages))
            return;

        currentPage = page;
        await LoadTransactionsAsync();
    }

    // Modal Operations
    private void OpenCreateModal()
    {
        isEditing = false;
        modalErrorMessage = null;
        formModel = new TransactionFormModel
        {
            Date = DateTime.Today,
            Type = TransactionType.Expense,
            Amount = 0m,
            Description = string.Empty
        };

        // Pre-select first category matching Expense
        var defaultCategory = FormCategories.FirstOrDefault();
        if (defaultCategory != null)
        {
            formModel.CategoryId = defaultCategory.Id;
        }

        showFormModal = true;
    }

    private void OpenEditModal(TransactionDto dto)
    {
        isEditing = true;
        modalErrorMessage = null;
        formModel = TransactionFormModel.FromDto(dto);
        showFormModal = true;
    }

    private void CloseFormModal()
    {
        showFormModal = false;
        modalErrorMessage = null;
    }

    private void OnFormTypeChanged(TransactionType newType)
    {
        formModel.Type = newType;
        // Adjust category to match new type
        var matchingCategories = allCategories.Where(c => c.Type == newType).ToList();
        if (!matchingCategories.Any(c => c.Id == formModel.CategoryId))
        {
            formModel.CategoryId = matchingCategories.FirstOrDefault()?.Id ?? 0;
        }
    }

    private async Task HandleFormSubmit()
    {
        isSubmitting = true;
        modalErrorMessage = null;

        try
        {
            if (isEditing)
            {
                var updateDto = formModel.ToUpdateDto();
                await TransactionService.UpdateAsync(updateDto);
                successMessage = "Transaction updated successfully.";
            }
            else
            {
                var createDto = formModel.ToCreateDto();
                await TransactionService.CreateAsync(createDto);
                successMessage = "Transaction created successfully.";
            }

            CloseFormModal();
            await LoadTransactionsAsync();
        }
        catch (ApplicationValidationException vex)
        {
            modalErrorMessage = vex.Message;
        }
        catch (NotFoundException nfe)
        {
            modalErrorMessage = nfe.Message;
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenDeleteModal(TransactionDto dto)
    {
        transactionToDelete = dto;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        transactionToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (transactionToDelete == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var success = await TransactionService.DeleteAsync(transactionToDelete.Id);
            if (success)
            {
                successMessage = $"Transaction '{transactionToDelete.Description}' deleted successfully.";
            }
            else
            {
                errorMessage = "Failed to delete transaction. It may have already been removed.";
            }

            CloseDeleteModal();
            await LoadTransactionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting transaction: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static string FormatMoney(decimal amount)
    {
        return $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} ₸";
    }

